# Copy this file to .env and adjust as needed.

# Secret used to sign JWT access tokens. Use >=32 bytes. CHANGE THIS in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me-in-production-0123456789

# How long an access token stays valid (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL. Defaults to a local SQLite file (zero setup).
# To use Postgres later:  postgresql+psycopg://user:pass@localhost:5432/constructai
DATABASE_URL=sqlite:///./constructai.db

# Comma-separated list of frontend origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
