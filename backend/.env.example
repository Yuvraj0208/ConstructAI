# Copy this file to .env and adjust as needed.

# Secret used to sign JWT access tokens. Use >=32 bytes. CHANGE THIS in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me-in-production-0123456789

# How long an access token stays valid (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL.
#   PostgreSQL (recommended):  postgresql+psycopg://USER:PASSWORD@localhost:5432/constructai
#   SQLite (zero-setup dev):    sqlite:///./constructai.db
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/constructai

# Comma-separated list of frontend origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- AI provider (all OPTIONAL) -----
# Leave everything unset to use the built-in, free, rule-based fallback.
# AI_PROVIDER picks the LLM backend: "anthropic" | "openai" | "ollama".
# AI_PROVIDER=ollama
#
# Ollama — LOCAL, free, no API key. Install from https://ollama.com, then:
#   ollama pull llama3.1            # tool-capable text model
#   ollama pull llama3.2-vision     # for site-photo analysis
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1
# OLLAMA_VISION_MODEL=llama3.2-vision
#
# Anthropic (Claude) — paid:
# ANTHROPIC_API_KEY=sk-ant-...
#
# OpenAI-compatible (OpenAI, Groq, OpenRouter, Gemini compat…) — usually paid:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
